# Claude API key (required) — scoring + summarization run on Claude.
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for both scoring and summarization.
ARXIV_MODEL="claude-sonnet-4-6"

# arXiv categories to scan (comma-separated).
ARXIV_CATEGORIES="cs.CV"

# How many recent entries to pull from the listing page (arXiv allows 25/50/100/250/2000).
ARXIV_MAX="250"

# Score tiers (0–100).
ARXIV_SCORE_THRESHOLD="50"   # below this is excluded from the report
ARXIV_TOP_PICK_MIN="80"      # at/above this gets a full-text structured summary
ARXIV_MAX_TOP_PICKS="0"      # 0 = no cap: summarize every paper >= TOP_PICK_MIN (quality-driven)

# Concurrent scoring requests (bounded to respect rate limits).
ARXIV_CONCURRENCY="6"

# Slack incoming webhooks for the digest. SLACK_WEBHOOK_URL_2 is optional (second workspace).
SLACK_WEBHOOK_URL=""
SLACK_WEBHOOK_URL_2=""
